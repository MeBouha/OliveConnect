{
  "info": {
    "name": "OliveConnect API",
    "description": "Collection Postman pour l'API OliveConnect. La requête Login stocke automatiquement le JWT dans la variable collection token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('token', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer@oliveconnect.tn\",\n  \"password\": \"Farmer@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Orchards",
      "item": [
        {
          "name": "Map markers",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/api/orchards/map?bbox=10.0,34.2,11.5,35.1"
          }
        },
        {
          "name": "List orchards",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orchards?page=0&size=20"
          }
        },
        {
          "name": "Create orchard",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Oliveraie test\",\n  \"variety\": \"Chemlali\",\n  \"areaHa\": 12,\n  \"geometry\": { \"type\": \"Point\", \"coordinates\": [10.8, 35.2] }\n}"
            },
            "url": "{{baseUrl}}/api/orchards"
          }
        }
      ]
    },
    {
      "name": "Harvests",
      "item": [
        {
          "name": "List harvests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/harvests?page=0&size=20"
          }
        },
        {
          "name": "Create harvest request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orchardId\": \"{{orchardId}}\",\n  \"type\": \"PLANNED\",\n  \"requestedDate\": \"2026-11-30T08:00:00Z\",\n  \"notes\": \"Demande de test\"\n}"
            },
            "url": "{{baseUrl}}/api/harvests"
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List alerts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/alerts?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Tours",
      "item": [
        {
          "name": "List tours",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tours?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/resources/availability?from=2026-11-24T08:00:00Z&to=2026-11-25T18:00:00Z"
          }
        },
        {
          "name": "Supplies",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/resources/supplies"
          }
        }
      ]
    },
    {
      "name": "Presses",
      "item": [
        {
          "name": "List presses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/presses"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "KPIs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/kpis"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/status"
          }
        },
        {
          "name": "Trigger import",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"weather-json\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/imports/trigger"
          }
        }
      ]
    }
  ]
}
